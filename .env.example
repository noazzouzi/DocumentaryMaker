# DocumentaryMaker environment — copy what you need into ~/.documentarymaker/.env (canonical, mode 0600)
# or <repo>/.env.local (developer convenience). Precedence: process env > <home>/.env > <repo>/.env.local.
# Every key is optional: with none set, `docmaker demo --offline` still produces a full video and export bundle.
# Never commit real values. `docmaker keys set <NAME>` writes <home>/.env for you.

# ---- secrets (ENV_KEYS)
# Claude API (research, outline, script, beats, fact-check). Without it, only fixture projects run.
ANTHROPIC_API_KEY=
# ElevenLabs TTS (paid voice takes; the free scratch take never needs it).
ELEVENLABS_API_KEY=
# Pexels / Pixabay stock (free keys).
PEXELS_API_KEY=
PIXABAY_API_KEY=
# fal.ai FLUX images (paid; never used for real people).
FAL_KEY=
# Brave image search (paid; unknown-licence editorial results).
BRAVE_API_KEY=
# Openverse client credentials (optional; raises rate limits).
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
# YouTube Data API (optional; search falls back to local yt-dlp).
YOUTUBE_API_KEY=
# Remotion Company License key (only if your organisation needs one).
REMOTION_LICENSE_KEY=

# ---- settings (ENV_SETTINGS)
# Home directory for caches, models, SFX, styles, browser.json (default ~/.documentarymaker).
DOCMAKER_HOME=
# Where projects live (default <repo>/projects).
DOCMAKER_PROJECTS=
# Repo root override (default: nearest ancestor containing pnpm-workspace.yaml).
DOCMAKER_REPO_ROOT=
# Contact for the Wikimedia/Wikidata/Openverse User-Agent (URL or email). Sent ONLY to those hosts.
DOCMAKER_CONTACT=
# debug | info | warn | error (default info).
DOCMAKER_LOG_LEVEL=
# ffmpeg / ffprobe binaries (default "ffmpeg" / "ffprobe" from PATH; ≥ 6.1).
DOCMAKER_FFMPEG=
DOCMAKER_FFPROBE=
# "1" forces offline mode everywhere (no socket is ever opened).
DOCMAKER_OFFLINE=
# Auto-approve cost estimates below this many USD (editorial gates are never auto-approved).
DOCMAKER_AUTO_APPROVE_USD=
# Cap of the media blob cache in GB (default min(20, 50 % of free disk)).
DOCMAKER_CACHE_MAX_GB=
# YouTube helpers for yt-dlp (PO-token provider URL; browser to read cookies from — opt-in, ban risk).
DOCMAKER_YT_POT_URL=
DOCMAKER_YT_COOKIES_BROWSER=
# Machine-wide render lock file (default /tmp/docmaker-render.lock).
DOCMAKER_RENDER_LOCK=
# Chrome Headless Shell executable (overrides <home>/browser.json).
DOCMAKER_BROWSER_EXECUTABLE=
# "1" enables network/paid tests (never in CI).
DOCMAKER_LIVE_TESTS=
